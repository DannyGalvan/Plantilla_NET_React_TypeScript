# Phase 5.2 — pnpm configuration.
# `node-linker=hoisted` makes the workspace look like a flat node_modules so
# vite + react-refresh + lint-staged resolve the same way they did under
# npm. Without it, sub-packages with CJS entry points (eslint plugins,
# HeroUI internals) get unhappy.
node-linker=hoisted

# Auto-install peers without an explicit peer dep block.
auto-install-peers=true

# Lockfile drift is a CI failure, not a warning.
strict-peer-dependencies=false
