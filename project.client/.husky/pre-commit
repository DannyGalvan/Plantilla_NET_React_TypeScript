#!/usr/bin/env sh
# Phase 5.2 — pre-commit hook: run lint-staged on staged files so the
# staged changes are guaranteed to satisfy `npm run lint`.
. "$(dirname -- "$0")/_/husky.sh"

cd "$(git rev-parse --show-toplevel)/project.client" 2>/dev/null || cd .

npx --no-install lint-staged --concurrent=false 2>/dev/null || \
  npx lint-staged --concurrent=false
