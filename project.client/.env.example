# Vite environment example. Copy to `.env.local` and adjust per environment.
# Anything prefixed with `VITE_` is exposed to the browser bundle. NEVER put
# secrets in this file — the browser ships these values verbatim.

# Base URL for the API. Empty means same-origin (dev proxy). In production
# set this to the deployed origin, e.g. https://api.example.com
VITE_API_URL=