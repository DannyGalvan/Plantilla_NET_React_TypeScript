# Copy to deploy/docker/.env and replace every <...> value. Never commit the real .env.
# Generate secrets with:  openssl rand -base64 48   (PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 })))

DB_NAME=project
DB_USER=project
DB_PASSWORD=<strong-database-password>

# Master key: encrypts every secret stored in the database (the JWT key is generated on the first start).
# Generate it once with: openssl rand -base64 32. Keep a copy in your vault: without it the secrets cannot be read.
MASTER_KEY=<openssl-rand-base64-32>

ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<first-admin-password-min-10-chars-Upper-lower-digit-symbol>

# None | SharedDatabase | DatabasePerTenant | Hybrid
TENANCY_MODE=None
API_PORT=8080
