# Copy to /etc/project/api.env, replace the <...> values and run: sudo chmod 600 /etc/project/api.env
Database__Provider=PostgreSql
Database__ConnectionStrings__Default=Host=localhost;Database=project;Username=project;Password=<password>
# Encrypts the secrets stored in the database. Generate once with: openssl rand -base64 32
Configuration__MasterKey=<openssl-rand-base64-32>
Seed__AdminPassword=<first-admin-password>
Hosting__KnownProxies__0=127.0.0.1
Cache__Redis__ConnectionString=
