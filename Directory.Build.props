<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Fase 0: suprimimos las reglas que requieren refactor mayor, fuera del alcance
      de "preparación y base de build" (Comportamiento funcional sin cambios).
      - CA1848: usar LoggerMessage source-generated (Fase 1, ServiceDefaults/Serilog).
      - CA1873: comprobar logger.IsEnabled antes de construir el mensaje.
      - CA1727: plantilla de log en PascalCase para marcadores con nombre.
      - CA1305: pasar CultureInfo.InvariantCulture a DateTime.ToString.
      Las revaluaremos al cierre de cada fase.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1727;CA1305;CA1861;CA2016;AD0001</NoWarn>
  </PropertyGroup>

</Project>