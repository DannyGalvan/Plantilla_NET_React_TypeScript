{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSql",
    "ConnectionStrings": {
      "Default": ""
    }
  },
  "Tenancy": {
    "Mode": "None"
  },
  "Modules": {
    "Disabled": []
  }
}
