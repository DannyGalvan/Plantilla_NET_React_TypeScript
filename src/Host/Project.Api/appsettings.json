{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSql",
    "ConnectionStrings": {
      "Default": ""
    },
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5,
    "MigrateOnStartup": false
  },
  "Tenancy": {
    "Mode": "None",
    "Resolvers": [ "Host", "Subdomain", "Claim" ],
    "RootDomain": null,
    "DefaultTenantDomains": [ "localhost", "127.0.0.1" ]
  },
  "Jwt": {
    "Issuer": "project-api",
    "Audience": "project-client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Identity": {
    "PublicUrl": "https://localhost:5173",
    "PasswordResetMinutes": 30
  },
  "Seed": {
    "AdminUserName": "admin",
    "AdminEmail": "admin@example.com",
    "AdminPassword": "",
    "SampleData": false
  },
  "Cache": {
    "Redis": {
      "ConnectionString": ""
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalPermitPerMinute": 300,
    "AuthPermitPer15Minutes": 10
  },
  "Pagination": {
    "MaxPageSize": 100
  },
  "Hosting": {
    "ServeSpa": true,
    "UseHttpsRedirection": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "From": "no-reply@example.com"
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalSeconds": 5
  },
  "Features": {
    "platform.admin": false
  },
  "Settings": {
    "branding": {
      "DisplayName": "Plantilla"
    },
    "localization": {
      "Locale": "es",
      "Currency": "USD",
      "TimeZone": "UTC"
    }
  },
  "Modules": {
    "Disabled": []
  }
}
