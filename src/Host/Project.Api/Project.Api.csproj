<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>Host HTTP: compone la plataforma y los modulos. Sirve la SPA desde wwwroot en produccion.</Description>
    <UserSecretsId>project-template-api</UserSecretsId>
    <SpaRoot>..\..\project.client\</SpaRoot>
    <SpaProxyLaunchCommand>pnpm dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:5173</SpaProxyServerUrl>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Project.ServiceDefaults\Project.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Project.Web\Project.Web.csproj" />
    <ProjectReference Include="..\..\Modules\Tenancy\Project.Modules.Tenancy.Infrastructure\Project.Modules.Tenancy.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Project.Modules.Identity.Infrastructure\Project.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Organization\Project.Modules.Organization.Infrastructure\Project.Modules.Organization.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\Project.Modules.Catalog.Infrastructure\Project.Modules.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Migrations\Project.Migrations.SqlServer\Project.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\Migrations\Project.Migrations.PostgreSql\Project.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\..\Migrations\Project.Migrations.MySql\Project.Migrations.MySql.csproj" />
  </ItemGroup>

  <!--
    dotnet publish builds the SPA (pnpm) and copies dist/ into wwwroot. Docker builds the SPA in its own stage and
    passes -p:SkipSpaBuild=true.
  -->
  <Target Name="PublishSpa" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipSpaBuild)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="pnpm install --frozen-lockfile" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="pnpm build" />
    <ItemGroup>
      <SpaDistFiles Include="$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(SpaDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
