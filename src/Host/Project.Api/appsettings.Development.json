{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "SampleData": true
  },
  "RateLimiting": {
    "AuthPermitPer15Minutes": 100
  },
  "Modules": {
    "Enabled": [ "Catalog" ]
  },
  "Features": {
    "platform.admin": true
  }
}
